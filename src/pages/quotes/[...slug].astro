---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
	const quotes = await getCollection('quotes');
	return quotes.map((entry) => ({
		params: { slug: entry.id },
		props: entry,
	}));
}

type Props = CollectionEntry<'quotes'>;

const entry = Astro.props;
const { Content } = await render(entry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={entry.data.title} description={`Quote from ${entry.data.sourceTitle}`} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.quote-meta {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin-bottom: 2rem;
			}
			.prose {
				line-height: 1.8;
			}
			.back {
				display: inline-block;
				margin-top: 2rem;
				font-size: 0.9em;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.back:hover {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="quote-meta">
					<FormattedDate date={entry.data.date} />
					{entry.data.author && <> · {entry.data.author}</>}
				</div>
				<div class="prose">
					<Content />
				</div>
				<a href="/quotes/" class="back">← All quotes</a>
			</article>
		</main>
		<Footer />
	</body>
</html>
